# Copy to .env to override the defaults in app/config.py
DATABASE_URL=postgresql+asyncpg://dlinfochat:dlinfochat@127.0.0.1:5433/dlinfochat
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3.5:9b
CHAT_NUM_CTX=8192
CHAT_THINK=false
CHAT_TEMPERATURE=0.2
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIMENSIONS=1024
INGEST_CONCURRENCY=2
CHUNK_MAX_CHARS=1500
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=6
RRF_K=60
# Optional reranker, needs requirements-rerank.txt (see README). Empty = off.
RERANKER_MODEL=
RERANK_DEPTH=20
